{
  "$defs": {
    "AgentRole": {
      "enum": [
        "planner",
        "acquisition",
        "support",
        "content",
        "analytics",
        "judge"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "PayloadRef": {
      "additionalProperties": false,
      "description": "Pointer into immutable object storage. Never inline large payloads.",
      "properties": {
        "bucket": {
          "minLength": 1,
          "title": "Bucket",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "bucket",
        "key",
        "sha256",
        "size_bytes"
      ],
      "title": "PayloadRef",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One agent invocation inside a run. steps table row.\n\nlatency_ms is wall time; ttft_ms is time-to-first-token (the DAG\ncritical-path budget is enforced against ttft, not wall time).",
  "properties": {
    "agent_role": {
      "$ref": "#/$defs/AgentRole"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "input_ref": {
      "$ref": "#/$defs/PayloadRef"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "output_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/PayloadRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parent_step_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Step Id"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "step_id": {
      "title": "Step Id",
      "type": "string"
    },
    "step_index": {
      "minimum": 0,
      "title": "Step Index",
      "type": "integer"
    },
    "tokens": {
      "$ref": "#/$defs/TokenUsage"
    },
    "ttft_ms": {
      "minimum": 0,
      "title": "Ttft Ms",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "step_index",
    "agent_role",
    "prompt_version",
    "model",
    "input_ref",
    "tokens",
    "latency_ms",
    "ttft_ms"
  ],
  "title": "Step",
  "type": "object"
}
